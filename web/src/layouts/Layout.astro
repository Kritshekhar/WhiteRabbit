---
import '@/styles/global.css';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';

export type Section = 'home' | 'conferences' | 'grants' | 'fellowships' | 'proceedings' | 'about' | 'none';

interface Props {
  title: string;
  description?: string;
  section: Section;
  /* preview image, as a path under the site root (e.g. 'og/venue/fast.png');
     defaults to the section's own card */
  image?: string;
  /* schema.org structured data, one object or several */
  jsonLd?: object | object[];
}

const { title, description = 'White Rabbit: self-updating deadlines for CS conferences, grants and fellowships, with proceedings statistics.', section, image, jsonLd } = Astro.props;
const fullTitle = section === 'home' ? title : `${title} · White Rabbit`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const SECTION_CARD: Record<string, string> = { home: 'home', conferences: 'conferences', grants: 'grants',
  fellowships: 'fellowships', proceedings: 'proceedings', about: 'about' };
const imageUrl = new URL(image ?? `og/page/${SECTION_CARD[section] ?? 'home'}.png`, root);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="White Rabbit" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" type="application/xml" href={new URL('sitemap-index.xml', root)} />
    <link rel="alternate" type="application/rss+xml" title="White Rabbit: what changed" href={new URL('changes.xml', root)} />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={new URL('favicon.svg', root)} type="image/svg+xml" />
    <link rel="icon" href={new URL('favicon-32.png', root)} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={new URL('apple-touch-icon.png', root)} />
    <meta name="theme-color" content="#16151f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Apply a pinned theme before first paint, so there is no flash. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('cd-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-surface-1 focus:px-3 focus:py-2">
      Skip to content
    </a>
    <div class="glow" aria-hidden="true"></div>
    <Header section={section} />
    <main id="main" class="wrap flex-1 py-6 sm:py-8">
      <slot />
    </main>
    <Footer><slot name="footer" /></Footer>
  </body>
</html>
