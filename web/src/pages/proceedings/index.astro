---
import Layout from '@/layouts/Layout.astro';
import VenuePicker, { type PickerVenue } from '@/components/islands/VenuePicker';
import { StatsEmpty } from '@/components/StatsEmpty';
import { latestCompleteYear, overview, proceedingsFor, venuesWithData } from '@/lib/proceedings';
import { href } from '@/lib/utils';
import FieldShare from '@/components/islands/FieldShare';
import SpreadExplorer from '@/components/islands/SpreadExplorer';
import SvgLine from '@/components/insights/SvgLine.astro';
import Sparkline from '@/components/insights/Sparkline.astro';
import EraTimeline from '@/components/insights/EraTimeline.astro';
import { authorsOverview, eras, fieldShare, termLines } from '@/lib/insights';

const venues = venuesWithData();
const picker: PickerVenue[] = venues.map((v) => {
  const rows = proceedingsFor(v.id).filter((p) => p.accepted_count !== null);
  const y = latestCompleteYear(rows);
  return { id: v.id, name: v.name, full_name: v.full_name, tier: v.tier, latest: rows.find((p) => p.year === y)?.accepted_count ?? null };
});
const o = overview();
const max = Math.max(1, ...o.largest.map((x) => x.count));
const link = (id: string) => href(`proceedings/${encodeURIComponent(id)}/`);
const pct = (n: number) => `${n >= 0 ? '+' : ''}${Math.round(n * 100)}%`;
const era = eras();
const lines = termLines();
const field = fieldShare();
const authors = authorsOverview();
const share = (s: number) => `${(s * 100).toFixed(s < 0.01 ? 2 : 1)}%`;
/* latest official acceptance rate per venue, most selective first */
const rated = venuesWithData().map((v) => {
  const r = [...proceedingsFor(v.id)].reverse().find((p) => p.acceptance_rate !== null);
  return r ? { id: v.id, name: v.name, year: r.year, rate: r.acceptance_rate as number, submitted: r.submitted_count,
    accepted: r.accepted_official, source: r.acceptance_source } : null;
}).filter((x): x is NonNullable<typeof x> => x !== null).sort((a, b) => a.rate - b.rate);
---

<Layout title="Proceedings" section="proceedings" description="What CS venues publish: papers per year from DBLP, keywords and topic trends, across the full history of each venue.">
  <header class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Proceedings</h1>
    <p class="mt-1 max-w-3xl text-fg-2">
      Everything mined from past proceedings: how many papers each venue publishes, what they are about, and how that
      changes over the years. Counts come from DBLP and topics from OpenAlex.
    </p>
  </header>

  {venues.length === 0 ? (
    <StatsEmpty what="every tracked venue" />
  ) : (
    <div class="space-y-10">
      <section aria-labelledby="ov-h" class="space-y-3">
        <h2 id="ov-h" class="text-lg font-bold tracking-tight">Across all venues, {o.year}</h2>
        <p class="text-xs text-muted">
          {o.year} is the latest complete year. Paper counts are papers in each venue's main DBLP volume, not official acceptance counts.
        </p>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <section class="card p-4">
            <h3 class="mb-3 font-semibold">Largest venues</h3>
            <ol class="space-y-2">
              {o.largest.map((x) => (
                <li>
                  <a href={link(x.venue.id)} class="group block no-underline">
                    <span class="flex justify-between gap-2 text-sm"><span class="font-semibold group-hover:text-accent">{x.venue.name}</span><span class="font-mono tabular text-fg-2">{x.count.toLocaleString()}</span></span>
                    <span class="mt-1 block h-1.5 rounded-full bg-surface-2"><span class="block h-full rounded-full bg-accent" style={`width:${(x.count / max) * 100}%`}></span></span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
          <section class="card p-4">
            <h3 class="mb-1 font-semibold">Fastest growing</h3>
            <p class="mb-3 text-xs text-muted">Change over five years, venues with at least 20 papers five years ago.</p>
            {o.growing.length ? (
              <ol class="divide-y divide-border">
                {o.growing.map((x) => (
                  <li class="flex items-center justify-between gap-2 py-1.5 text-sm">
                    <a class="min-w-0 truncate font-semibold hover:text-accent" href={link(x.venue.id)}>{x.venue.name}</a>
                    <span class="shrink-0 font-mono text-xs text-muted tabular">{x.from} → {x.to}</span>
                    <span class:list={['w-14 shrink-0 text-right font-mono font-bold tabular', x.change >= 0 ? 'text-good' : 'text-critical']}>{pct(x.change)}</span>
                  </li>
                ))}
              </ol>
            ) : <p class="text-sm text-muted">Needs five years of history.</p>}
          </section>
          <section class="card p-4">
            <h3 class="mb-1 font-semibold">Trending keywords</h3>
            <p class="mb-3 text-xs text-muted">Title phrases whose share of all papers rose most against the three years before. Numbers are titles per year.</p>
            {o.trending.length ? (
              <ol class="divide-y divide-border">
                {o.trending.map((t) => (
                  <li class="flex items-center justify-between gap-2 py-1.5 text-sm">
                    <span class="min-w-0 truncate font-semibold">{t.term}</span>
                    <span class="shrink-0 font-mono text-xs text-muted tabular" title={`${t.count} titles in ${o.year} across ${t.venues} venues; about ${t.before} a year over the three years before`}>
                      {t.before} → <strong class="text-fg">{t.count}</strong>
                    </span>
                  </li>
                ))}
              </ol>
            ) : <p class="text-sm text-muted">No keywords mined yet.</p>}
          </section>
        </div>
      </section>

      {rated.length > 0 && (
        <section aria-labelledby="rates-h" class="card space-y-3 p-4 sm:p-5">
          <div>
            <h2 id="rates-h" class="text-lg font-bold tracking-tight">Acceptance rates</h2>
            <p class="text-xs text-muted">The latest figure each venue published itself, from its program chairs' message. Coverage is partial: only venues whose official figures can be read automatically (USENIX today) appear here.</p>
          </div>
          <ol class="divide-y divide-border">
            {rated.map((r) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
                <a class="font-semibold text-fg no-underline hover:text-accent" href={href(`proceedings/${r.id}/`)}>{r.name} <span class="font-normal text-muted">{r.year}</span></a>
                <span class="flex items-center gap-3 font-mono text-xs tabular">
                  {r.submitted && <span class="text-muted">{r.accepted ? `${r.accepted} of ${r.submitted}` : `${r.submitted} submitted`}</span>}
                  <a class="text-base font-bold text-fg no-underline hover:text-accent" href={r.source} target="_blank" rel="noopener" title="Source: the program chairs' message">{(r.rate * 100).toFixed(1)}%</a>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section aria-labelledby="eras-h" class="card space-y-3 p-4 sm:p-5">
        <div>
          <h2 id="eras-h" class="text-lg font-bold tracking-tight">Research eras</h2>
          <p class="text-xs text-muted">The idea that broke out each year across all tracked venues, each shown once, in the year it took off. Click one to see where it spread.</p>
        </div>
        {era.length ? (
          <EraTimeline eras={era} />
        ) : <p class="text-sm text-muted">Not enough years mined yet.</p>}
      </section>

      <section aria-labelledby="rf-h" class="space-y-3">
        <div>
          <h2 id="rf-h" class="text-lg font-bold tracking-tight">Rising and fading</h2>
          <p class="text-xs text-muted">Share of all tracked titles using each phrase, {lines.rising[0]?.points[0]?.year ?? 2005} to {lines.rising[0]?.points.at(-1)?.year ?? 'now'}. The dot marks its peak. Click a phrase to see where it spread.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {([['Rising', lines.rising, 'var(--rank-base)'], ['Faded since their peak', lines.fading, 'var(--serious)']] as const).map(([title, list, color]) => (
            <section class="card p-4">
              <h3 class="mb-2 font-semibold">{title}</h3>
              {list.length ? (
                <ol class="divide-y divide-border">
                  {list.map((t) => (
                    <li class="flex items-center gap-3 py-1.5 text-sm">
                      <button type="button" data-term={t.term} class="wr-term min-w-0 flex-1 cursor-pointer truncate text-left font-semibold hover:text-accent">{t.term}</button>
                      <Sparkline points={t.points} color={color} label={t.term} />
                      <span class="w-[4.5rem] shrink-0 text-right font-mono text-xs text-muted tabular sm:w-24">
                        {t.kind === 'fading' ? <>peak {t.peak_year}</> : <>{share(t.now_share)}</>}
                      </span>
                    </li>
                  ))}
                </ol>
              ) : <p class="text-sm text-muted">Phrase history is still being mined.</p>}
            </section>
          ))}
        </div>
      </section>

      <section aria-labelledby="spread-h" id="spread" class="card scroll-mt-20 space-y-3 p-4 sm:p-5">
        <div>
          <h2 id="spread-h" class="text-lg font-bold tracking-tight">Where an idea spreads</h2>
          <p class="text-xs text-muted">Share of each venue's titles using a phrase, per year. Venues are ordered by when the phrase first passed 1% of their titles.</p>
        </div>
        <SpreadExplorer client:visible url={href('proceedings/spread.json')} />
      </section>

      <section aria-labelledby="field-h" class="card space-y-3 p-4 sm:p-5">
        <div>
          <h2 id="field-h" class="text-lg font-bold tracking-tight">Field share</h2>
          <p class="text-xs text-muted">Papers per year across tracked venues, grouped by each venue's primary topic. It reflects the venues tracked here, not all of computer science.</p>
        </div>
        {field.rows.length ? <FieldShare client:visible rows={field.rows} areas={field.areas} /> : <p class="text-sm text-muted">No counts yet.</p>}
      </section>

      <section aria-labelledby="auth-h" class="space-y-3">
        <div>
          <h2 id="auth-h" class="text-lg font-bold tracking-tight">Authors</h2>
          <p class="text-xs text-muted">From DBLP author lists of papers in each venue's main volume. Names appear as DBLP lists them.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <section class="card p-4">
            <h3 class="mb-1 font-semibold">Team size</h3>
            <p class="mb-3 text-xs text-muted">Authors per paper across all tracked venues, weighted by papers.</p>
            {authors.teamSize.length ? (
              <>
                <p class="mb-2 text-sm"><span class="font-mono text-2xl font-bold tabular">{authors.teamSize.at(-1)!.mean.toFixed(1)}</span> <span class="text-muted">in {authors.teamSize.at(-1)!.year}, from {authors.teamSize[0].mean.toFixed(1)} in {authors.teamSize[0].year}</span></p>
                <SvgLine points={authors.teamSize.map((p) => ({ x: p.year, y: p.mean }))} label="Authors per paper" width={340} height={170} />
              </>
            ) : <p class="text-sm text-muted">Author data is still being mined.</p>}
          </section>
          <section class="card p-4">
            <h3 class="mb-1 font-semibold">Papers by an entirely new team</h3>
            <p class="mb-3 text-xs text-muted">Share of {authors.welcomingYear} papers where no author had published at that venue before. Venues with 50 or more papers.</p>
            {authors.welcoming.length ? (
              <ol class="space-y-2">
                {authors.welcoming.map((x) => (
                  <li>
                    <a href={link(x.venue.id)} class="group block no-underline">
                      <span class="flex justify-between gap-2 text-sm"><span class="font-semibold group-hover:text-accent">{x.venue.name}</span><span class="font-mono tabular text-fg-2">{Math.round(x.share * 100)}%</span></span>
                      <span class="mt-1 block h-1.5 rounded-full bg-surface-2"><span class="block h-full rounded-full bg-rank-base" style={`width:${x.share * 100}%`}></span></span>
                    </a>
                  </li>
                ))}
              </ol>
            ) : <p class="text-sm text-muted">Author data is still being mined.</p>}
          </section>
          <section class="card p-4">
            <h3 class="mb-1 font-semibold">Most published authors</h3>
            <p class="mb-3 text-xs text-muted">Papers across all tracked venues' main volumes.</p>
            {authors.top.length ? (
              <ol class="divide-y divide-border">
                {authors.top.map((a) => (
                  <li class="flex items-center justify-between gap-2 py-1.5 text-sm">
                    <span class="min-w-0"><span class="block truncate font-semibold" title={a.name}>{a.name.replace(/ \d{4}$/, '')}</span><span class="block font-mono text-xs text-muted tabular">{a.first_year} to {a.last_year}</span></span>
                    <span class="shrink-0 font-mono font-bold tabular">{a.papers}</span>
                  </li>
                ))}
              </ol>
            ) : <p class="text-sm text-muted">Author data is still being mined.</p>}
          </section>
        </div>
      </section>

      <section aria-labelledby="pick-h" class="space-y-3">
        <h2 id="pick-h" class="text-lg font-bold tracking-tight">Pick a venue</h2>
        <VenuePicker client:load venues={picker} />
      </section>
    </div>
  )}
</Layout>

<script>
  // Phrase buttons anywhere on the page drive the spread explorer.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.wr-term');
    if (!btn?.dataset.term) return;
    window.dispatchEvent(new CustomEvent('wr:term', { detail: btn.dataset.term }));
    document.getElementById('spread')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>
