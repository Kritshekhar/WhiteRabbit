---
import Layout from '@/layouts/Layout.astro';
import ProceedingsVenue, { type YearRow } from '@/components/islands/ProceedingsVenue';
import VenuePicker, { type PickerVenue } from '@/components/islands/VenuePicker';
import { Badge } from '@/components/ui/badge';
import { latestCompleteYear, proceedingsFor, topicsFor, venueSummary, venuesWithData, yearStatus } from '@/lib/proceedings';
import { RANK_SLOT, TIERS } from '@/lib/tiers';
import type { Venue } from '@/lib/types';
import { href, venueHref } from '@/lib/utils';
import SvgLine from '@/components/insights/SvgLine.astro';
import { similarTo, venueAuthors } from '@/lib/insights';

export function getStaticPaths() {
  return venuesWithData().map((venue) => ({ params: { id: venue.id }, props: { venue } }));
}

const { venue } = Astro.props as { venue: Venue };
const all = proceedingsFor(venue.id);
const rows: YearRow[] = all.map((p) => ({
  year: p.year, count: p.accepted_count, rate: p.acceptance_rate, status: yearStatus(p), source: p.source,
  submitted: p.submitted_count, acceptedOfficial: p.accepted_official, rateSource: p.acceptance_source,
  rateKind: p.acceptance_kind,
  links: JSON.parse(p.links || '[]'),
}));
const counted = all.filter((p) => p.accepted_count !== null);
const defaultYear = latestCompleteYear(counted);
const summary = venueSummary(venue.id);
const total = counted.reduce((n, p) => n + (p.accepted_count ?? 0), 0);
const first = counted[0]?.year;
const similar = similarTo(venue.id);
const authorStats = venueAuthors(venue.id);
const newcomers = authorStats.years.filter((y) => y.newcomer_share !== null);
/* DBLP tells namesakes apart with a numeric suffix ("Jun Zhu 0001"); the
   full form stays in the tooltip. */
const displayName = (n: string) => n.replace(/ \d{4}$/, '');
const procLink = (id: string) => href(`proceedings/${encodeURIComponent(id)}/`);
const picker: PickerVenue[] = venuesWithData().map((v) => ({ id: v.id, name: v.name, full_name: v.full_name, tier: v.tier, latest: null }));
---

<Layout title={`${venue.name} proceedings`} section="proceedings" image={`og/venue/${venue.id}.png`} description={`${venue.name} proceedings: papers per year since ${first}, keywords and topic trends.`}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted">
    <a class="hover:text-fg" href={href('proceedings/')}>Proceedings</a> <span aria-hidden="true">/</span> <span class="text-fg-2">{venue.name}</span>
  </nav>

  <header class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight">{venue.name} proceedings</h1>
      {venue.full_name && <p class="text-lg text-fg-2">{venue.full_name}</p>}
      <div class="flex flex-wrap items-center gap-1.5">
        {venue.publisher && <Badge variant="publisher">{venue.publisher}</Badge>}
        <Badge variant={RANK_SLOT[venue.tier] || 'off'}>{TIERS[venue.tier] || venue.tier}</Badge>
        <a class="ml-1 text-sm font-semibold text-accent hover:underline" href={venueHref(venue.id)}>Deadlines for {venue.name}</a>
      </div>
    </div>
    <VenuePicker client:idle venues={picker} current={venue.id} compact />
  </header>

  <section class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="Summary">
    <div class="card p-3"><p class="text-[0.68rem] font-semibold tracking-wide text-muted uppercase">Papers in {summary.latest?.year ?? 'latest year'}</p><p class="text-xl font-bold tabular">{summary.latest?.accepted_count?.toLocaleString() ?? 'n/a'}</p></div>
    <div class="card p-3"><p class="text-[0.68rem] font-semibold tracking-wide text-muted uppercase">Papers, all years</p><p class="text-xl font-bold tabular">{total.toLocaleString()}</p></div>
    <div class="card p-3"><p class="text-[0.68rem] font-semibold tracking-wide text-muted uppercase">Years indexed</p><p class="text-xl font-bold tabular">{counted.length}</p></div>
    <div class="card p-3"><p class="text-[0.68rem] font-semibold tracking-wide text-muted uppercase">Since</p><p class="text-xl font-bold tabular">{first ?? 'n/a'}</p></div>
  </section>

  <ProceedingsVenue
    client:visible
    rows={rows}
    topics={topicsFor(venue.id)}
    keywordsUrl={href(`proceedings/${encodeURIComponent(venue.id)}.json`)}
    defaultYear={defaultYear}
  />

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="card min-w-0 p-4 sm:p-5" aria-labelledby="like-h">
      <h3 id="like-h" class="font-semibold">Venues like {venue.name}</h3>
      <p class="mt-0.5 mb-3 text-xs text-muted">Closest by the phrases in their paper titles over the last five complete years.</p>
      {similar.length ? (
        <ol class="space-y-3">
          {similar.map((x) => (
            <li>
              <a href={procLink(x.venue.id)} class="group block no-underline">
                <span class="flex items-baseline justify-between gap-2 text-sm">
                  <span class="min-w-0 truncate"><span class="font-semibold group-hover:text-accent">{x.venue.name}</span> <span class="text-xs text-muted">{x.venue.full_name}</span></span>
                  <span class="shrink-0 font-mono text-xs text-fg-2 tabular" title="Cosine similarity of title phrases, 0 to 1">{x.score.toFixed(2)}</span>
                </span>
                <span class="mt-1 block h-1.5 rounded-full bg-surface-2"><span class="block h-full rounded-full bg-accent" style={`width:${Math.min(100, x.score * 100)}%`}></span></span>
              </a>
              {x.shared.length > 0 && (
                <span class="mt-1.5 flex flex-wrap gap-1">
                  {x.shared.map((t) => <span class="rounded-full bg-surface-2 px-2 py-0.5 text-[0.7rem] font-semibold text-fg-2">{t}</span>)}
                </span>
              )}
            </li>
          ))}
        </ol>
      ) : <p class="text-sm text-muted">Similar venues are still being computed.</p>}
    </section>

    <section class="card min-w-0 p-4 sm:p-5" aria-labelledby="auth-h">
      <h3 id="auth-h" class="font-semibold">Authors</h3>
      <p class="mt-0.5 mb-3 text-xs text-muted">From DBLP author lists of the main volume. Names appear as DBLP lists them.</p>
      {authorStats.years.length > 1 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold text-fg-2">Authors per paper</p>
            <p class="mb-1 font-mono text-lg font-bold tabular">{authorStats.years.at(-1)!.mean_authors.toFixed(1)} <span class="text-xs font-normal text-muted">in {authorStats.years.at(-1)!.year}</span></p>
            <SvgLine points={authorStats.years.map((y) => ({ x: y.year, y: y.mean_authors }))} label="Authors per paper" height={150} width={320} />
          </div>
          <div>
            <p class="text-xs font-semibold text-fg-2" title="Share of papers where no author had published at this venue before">Papers by an entirely new team</p>
            {newcomers.length > 1 ? (
              <>
                <p class="mb-1 font-mono text-lg font-bold tabular">{Math.round((newcomers.at(-1)!.newcomer_share as number) * 100)}% <span class="text-xs font-normal text-muted">in {newcomers.at(-1)!.year}</span></p>
                <SvgLine points={newcomers.map((y) => ({ x: y.year, y: y.newcomer_share as number }))} format="percent" label="Papers by an entirely new team" color="var(--rank-base)" height={150} width={320} yMin={0} />
              </>
            ) : <p class="text-sm text-muted">Needs a few more years of history.</p>}
          </div>
        </div>
      ) : <p class="text-sm text-muted">Author data is still being mined.</p>}
      {authorStats.top.length > 0 && (
        <>
          <h4 class="mt-5 mb-1 text-sm font-semibold">Most published at {venue.name}</h4>
          <ol class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
            {authorStats.top.map((a) => (
              <li class="flex items-center justify-between gap-2 border-b border-border py-1.5 text-sm">
                <span class="min-w-0"><span class="block truncate font-semibold" title={a.name}>{displayName(a.name)}</span><span class="block font-mono text-[0.7rem] text-muted tabular">{a.first_year} to {a.last_year}</span></span>
                <span class="shrink-0 font-mono font-bold tabular">{a.papers}</span>
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  </div>
</Layout>
