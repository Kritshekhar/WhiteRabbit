---
import Layout from '@/layouts/Layout.astro';
import BrandMark from '@/components/site/BrandMark.astro';
import { ArrowRight, BookOpen, CalendarDays, HandCoins, MessageCircle } from 'lucide-react';
import { compact, homeData } from '@/lib/home';
import { getGrants, getProceedings, getVenues } from '@/lib/db';
import { href } from '@/lib/utils';

/* Figures come from the database at build time, so they never go stale. */
const { counts, verified } = homeData();
const years = getProceedings().map((p) => p.year);
const since = years.length ? Math.min(...years) : null;
const deadlines = [...getVenues(), ...getGrants()].flatMap((r) => r.deadlines).filter((d) => d.date).length;

/* The clock in the header: the next verified deadlines circle the rabbit like
   the hours on its pocket watch, with a few facts in between. */
const now = Date.now();
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (iso: string) => {
  const m = /([+-])(\d{2}):(\d{2})$/.exec(iso);
  const off = m ? (m[1] === '-' ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3])) : 0;
  const d = new Date(Date.parse(iso) + off * 60000);
  return `${MON[d.getUTCMonth()]} ${d.getUTCDate()}`;
};
const soon = getVenues()
  .map((v) => ({ v, d: v.deadlines.find((d) => d.confirmed && d.date && Date.parse(d.date) > now) }))
  .filter((x) => x.d)
  .sort((a, b) => Date.parse(a.d!.date!) - Date.parse(b.d!.date!))
  .filter((x, i, all) => all.findIndex((y) => y.v.id === x.v.id) === i)
  .slice(0, 5)
  .map(({ v, d }) => ({ text: `${v.name} · ${day(d!.date!)}`, kind: 'date' }));
const chips = [
  soon[0], { text: '✓ verified', kind: 'ok' }, soon[1], { text: `${compact(counts.papers)} papers`, kind: 'fact' },
  soon[2], { text: 'AoE', kind: 'fact' },
].filter(Boolean) as { text: string; kind: string }[];

const inside = [
  { Icon: CalendarDays, title: 'Conference deadlines', path: 'conferences/',
    body: `${counts.venues} venues across every area of computer science, with live countdowns and calendar feeds.` },
  { Icon: HandCoins, title: 'Grants and fellowships', path: 'grants/',
    body: `${counts.faculty + counts.fellowships} funding programmes for faculty and PhD students, with deadlines checked against the official call.` },
  { Icon: BookOpen, title: 'Proceedings statistics', path: 'proceedings/',
    body: `${compact(counts.papers)} papers since ${since ?? 'the start'}: venue sizes, acceptance rates, institutions, countries and rising ideas.` },
  { Icon: MessageCircle, title: 'Ask White Rabbit', path: '',
    body: 'An assistant that answers questions from this data, and links every answer to its page.' },
];

const steps = [
  { title: 'Read at the source', body: 'Each date is read on the venue’s or funder’s own page.' },
  { title: 'Labelled honestly', body: 'Verified dates link to that page. Anything not yet confirmed is marked est.' },
  { title: 'Checked every night', body: 'Estimated dates are re-read nightly. Verified dates are final.' },
];

const sources = [
  { name: 'Venue and funder websites', note: 'every verified date', url: '' },
  { name: 'DBLP', note: 'papers, volumes and authors (CC0)', url: 'https://dblp.org' },
  { name: 'OpenAlex', note: 'topics, institutions and countries (CC0)', url: 'https://openalex.org' },
  { name: 'Grants.gov', note: 'US federal funding calls', url: 'https://www.grants.gov' },
  { name: 'Conference-Acceptance-Rate', note: 'reported acceptance rates (MIT)', url: 'https://github.com/lixin4ever/Conference-Acceptance-Rate' },
];
---

<Layout title="About" section="about" description="White Rabbit tracks computer science deadlines, grants, fellowships and proceedings statistics, with every date checked against its official source.">
  <article class="mx-auto max-w-4xl space-y-12">
    <header class="wr-about-hero card relative grid items-center gap-6 overflow-hidden p-6 lg:grid-cols-[1fr_24rem] sm:p-8">
      <div class="relative z-10">
        <p class="wr-eyebrow">About</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">About White Rabbit</h1>
        <p class="mt-3 text-[1.05rem] text-fg-2">
          Every deadline, grant and proceedings statistic a computer science researcher needs, in one place, with
          each date checked against its official source.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={href('conferences/')} class="wr-btn-primary">Browse deadlines <ArrowRight className="size-4" aria-hidden="true" /></a>
          <a href={href('proceedings/')} class="wr-btn-ghost">Explore proceedings</a>
        </div>
      </div>

      <!-- the pocket watch: a dial with a sweeping hand, upcoming deadlines
           orbiting like its hours, and the rabbit at the centre -->
      <div class="wr-watch relative mx-auto aspect-square w-full max-w-[22rem]" aria-hidden="true">
        <svg class="absolute inset-0 size-full" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="96" class="wr-watch-rim" />
          <circle cx="100" cy="100" r="88" class="wr-watch-face" />
          {Array.from({ length: 60 }, (_, i) => (
            <line x1="100" y1={i % 5 ? 16 : 13} x2="100" y2="19" transform={`rotate(${i * 6} 100 100)`}
              class={i % 5 ? 'wr-tick' : 'wr-tick wr-tick-hour'} />
          ))}
          <g class="wr-hand-sweep"><line x1="100" y1="104" x2="100" y2="22" class="wr-hand" /><circle cx="100" cy="100" r="3" class="wr-hand-hub" /></g>
        </svg>
        <div class="wr-orbit absolute inset-0">
          {chips.map((c, i) => (
            <span class="wr-orbit-slot" style={`--a:${(360 / chips.length) * i}deg`}>
              <span class:list={['wr-orbit-chip', `is-${c.kind}`]}>{c.text}</span>
            </span>
          ))}
        </div>
        <div class="wr-watch-rabbit absolute inset-0 grid place-items-center"><BrandMark class="h-[6.5rem] w-auto" /></div>
      </div>
    </header>

    <dl class="card grid grid-cols-2 gap-px overflow-hidden bg-border p-0 sm:grid-cols-4">
      <div class="bg-surface-1 p-4"><dt class="text-xs text-muted">Venues</dt><dd class="mt-1 font-mono text-2xl font-bold tabular">{counts.venues}</dd></div>
      <div class="bg-surface-1 p-4"><dt class="text-xs text-muted">Funding programmes</dt><dd class="mt-1 font-mono text-2xl font-bold tabular">{counts.faculty + counts.fellowships}</dd></div>
      <div class="bg-surface-1 p-4"><dt class="text-xs text-muted">Verified deadlines</dt><dd class="mt-1 font-mono text-2xl font-bold tabular">{verified}<span class="text-sm font-normal text-muted"> / {deadlines}</span></dd></div>
      <div class="bg-surface-1 p-4"><dt class="text-xs text-muted">Papers indexed</dt><dd class="mt-1 font-mono text-2xl font-bold tabular">{compact(counts.papers)}</dd></div>
    </dl>

    <section aria-labelledby="inside-h">
      <h2 id="inside-h" class="text-xl font-bold tracking-tight">What’s inside</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {inside.map(({ Icon, title, body, path }) => (
          <li>
            <a href={href(path)} class="card group flex h-full gap-3 p-4 no-underline transition hover:-translate-y-0.5 hover:border-border-strong">
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent"><Icon className="size-4.5" aria-hidden="true" /></span>
              <span>
                <span class="block font-semibold text-fg group-hover:text-accent">{title}</span>
                <span class="mt-0.5 block text-sm text-fg-2">{body}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="checked-h">
      <h2 id="checked-h" class="text-xl font-bold tracking-tight">How dates are checked</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-3">
        {steps.map((st, i) => (
          <li class="card p-4">
            <span class="font-mono text-xs font-bold text-accent">0{i + 1}</span>
            <p class="mt-1 font-semibold">{st.title}</p>
            <p class="mt-1 text-sm text-fg-2">{st.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="sources-h">
      <h2 id="sources-h" class="text-xl font-bold tracking-tight">Sources</h2>
      <ul class="card mt-4 divide-y divide-border p-0">
        {sources.map((src) => (
          <li class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            {src.url
              ? <a href={src.url} target="_blank" rel="noopener" class="font-semibold text-fg no-underline hover:text-accent">{src.name} ↗</a>
              : <span class="font-semibold">{src.name}</span>}
            <span class="text-sm text-muted sm:text-right">{src.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="border-t border-border pt-6 text-sm text-fg-2">
      Spotted a wrong date?{' '}
      <a class="font-semibold text-accent hover:underline" href="https://github.com/Kritshekhar/WhiteRabbit/issues/new?template=wrong-date.yml" target="_blank" rel="noopener">Report it</a>{' '}
      with a link to the right one. Always confirm a date on its official page before you plan around it.
    </p>
  </article>
</Layout>

<style>
  .wr-about-hero {
    background:
      radial-gradient(60% 90% at 100% 0%, color-mix(in srgb, var(--mark-2) 16%, transparent), transparent 70%),
      radial-gradient(50% 80% at 0% 100%, color-mix(in srgb, var(--mark-1) 12%, transparent), transparent 70%),
      var(--surface-1);
  }
  /* the orbit scales with the watch, so it fits a phone as well */
  .wr-watch { container-type: inline-size; }
  .wr-watch-rim { fill: none; stroke: color-mix(in srgb, var(--mark-2) 35%, var(--border)); stroke-width: 3; }
  .wr-watch-face { fill: color-mix(in srgb, var(--surface-0) 70%, transparent); stroke: var(--border); stroke-width: 1; }
  .wr-tick { stroke: var(--border-strong); stroke-width: 1; }
  .wr-tick-hour { stroke: var(--text-muted); stroke-width: 2; }
  .wr-hand { stroke: var(--mark-3); stroke-width: 1.6; stroke-linecap: round; }
  .wr-hand-hub { fill: var(--mark-3); }
  .wr-hand-sweep { transform-origin: 100px 100px; animation: wr-sweep 12s linear infinite; }

  /* each chip sits on the ring; the ring turns, the chip turns back to stay upright */
  .wr-orbit { animation: wr-turn 60s linear infinite; }
  .wr-orbit-slot { position: absolute; left: 50%; top: 50%; transform: rotate(var(--a)) translateY(-41cqi) rotate(calc(-1 * var(--a))); }
  .wr-orbit-chip {
    display: block;
    translate: -50% -50%;
    white-space: nowrap;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    padding: 0.22rem 0.7rem;
    font: 600 clamp(0.6rem, 3.3cqi, 0.74rem)/1.4 Inter, system-ui, sans-serif;
    color: var(--text-secondary);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.06);
    animation: wr-unturn 60s linear infinite;
  }
  .wr-orbit-chip.is-ok { color: var(--good); border-color: color-mix(in srgb, var(--good) 40%, var(--border)); }
  .wr-orbit-chip.is-date { color: var(--text-primary); }
  .wr-watch-rabbit :global(svg) { animation: wr-bob 3.2s ease-in-out infinite; transform-origin: 50% 90%; filter: drop-shadow(0 6px 10px rgb(91 42 143 / 0.25)); }

  @keyframes wr-sweep { to { transform: rotate(360deg); } }
  @keyframes wr-turn { to { transform: rotate(360deg); } }
  @keyframes wr-unturn { to { transform: rotate(-360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .wr-hand-sweep, .wr-orbit, .wr-orbit-chip, .wr-watch-rabbit :global(svg) { animation: none; }
  }
</style>
