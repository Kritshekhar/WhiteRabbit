---
import { href } from '@/lib/utils';
---

<footer class="mt-10 border-t border-border">
  <!-- extra bottom room on phones, so the chat button does not cover the last line -->
  <div class="wrap space-y-3 pt-8 pb-24 text-sm text-fg-2 sm:pb-8">
    <slot />
    <p>
      Dates marked <span class="rounded-md border border-warning/50 bg-warning/12 px-1.5 text-[0.7rem] font-semibold">est.</span>
      have not been checked against the official page. <strong>Always confirm on the source before you plan around a date.</strong>
    </p>
    <p class="flex flex-wrap gap-x-4 gap-y-1 text-muted">
      <a class="hover:text-fg" href={href('about/')}>About</a>
      <a class="hover:text-fg" href={href('calendar/')}>Calendar feeds</a>
      <a class="hover:text-fg" href={href('changes/')}>What changed</a>
      <a class="hover:text-fg" href="https://github.com/Kritshekhar/WhiteRabbit" target="_blank" rel="noopener">Source and corrections</a>
      <span>Data refreshed nightly from a verified database.</span>
    </p>
  </div>
</footer>
