---
import { href } from '@/lib/utils';
import type { Section } from '@/layouts/Layout.astro';

interface Props { section: Section }
const { section } = Astro.props;

const links: { key: Section; label: string; path: string }[] = [
  { key: 'home', label: 'Home', path: '' },
  { key: 'conferences', label: 'Conferences', path: 'conferences/' },
  { key: 'grants', label: 'Grants', path: 'grants/' },
  { key: 'fellowships', label: 'Fellowships', path: 'fellowships/' },
  { key: 'proceedings', label: 'Proceedings', path: 'proceedings/' },
  { key: 'about', label: 'About', path: 'about/' },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-[color-mix(in_srgb,var(--surface-0)_82%,transparent)] backdrop-blur-md backdrop-saturate-150">
  <div class="wrap flex items-center gap-3 py-3">
    <a href={href()} class="flex shrink-0 items-center gap-2.5 no-underline" aria-label="White Rabbit home">
      <span class="grid size-9 place-items-center rounded-xl border border-border bg-accent-soft text-lg" aria-hidden="true">🐇</span>
      <span class="hidden text-[1.02rem] font-bold tracking-tight sm:inline">White Rabbit</span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={href(l.path)}
              aria-current={section === l.key ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 text-[0.85rem] font-semibold no-underline transition-colors',
                section === l.key ? 'bg-surface-2 text-fg' : 'text-fg-2 hover:bg-surface-2 hover:text-fg',
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-2">
      <a
        class="grid size-9 place-items-center rounded-xl border border-border bg-surface-1 text-fg-2 hover:border-border-strong hover:text-fg"
        href="https://github.com/Kritshekhar/WhiteRabbit" target="_blank" rel="noopener"
        aria-label="View this project on GitHub" title="View source on GitHub"
      >
        <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button
        id="theme-toggle" type="button"
        class="grid size-9 cursor-pointer place-items-center rounded-xl border border-border bg-surface-1 text-fg-2 hover:border-border-strong hover:text-fg"
        aria-label="Colour theme: system" title="Colour theme: system"
      >
        <span data-icon="system" aria-hidden="true">◐</span>
        <span data-icon="light" aria-hidden="true" hidden>☀</span>
        <span data-icon="dark" aria-hidden="true" hidden>☾</span>
      </button>
      <button
        id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"
        class="grid size-9 cursor-pointer place-items-center rounded-xl border border-border bg-surface-1 text-fg-2 md:hidden"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="wrap hidden pb-3 md:hidden">
    <ul class="grid grid-cols-2 gap-1.5">
      {links.map((l) => (
        <li>
          <a
            href={href(l.path)}
            aria-current={section === l.key ? 'page' : undefined}
            class:list={[
              'block rounded-lg border px-3 py-2 text-sm font-semibold no-underline',
              section === l.key ? 'border-accent bg-accent-soft text-accent' : 'border-border bg-surface-1 text-fg-2',
            ]}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  /* Theme: system, then light, then dark. 'cd-theme' is the same key the
     previous site used, so a returning visitor keeps their choice. */
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle')!;
  const order = ['system', 'light', 'dark'] as const;
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? 'system';
  const paint = () => {
    const mode = current();
    button.querySelectorAll<HTMLElement>('[data-icon]').forEach((el) => (el.hidden = el.dataset.icon !== mode));
    const text = `Colour theme: ${mode}`;
    button.setAttribute('aria-label', text);
    button.title = text;
  };
  button.addEventListener('click', () => {
    const next = order[(order.indexOf(current()) + 1) % order.length];
    try {
      if (next === 'system') { delete root.dataset.theme; localStorage.removeItem('cd-theme'); }
      else { root.dataset.theme = next; localStorage.setItem('cd-theme', next); }
    } catch { if (next !== 'system') root.dataset.theme = next; }
    paint();
  });
  paint();

  const menu = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('mobile-nav')!;
  menu.addEventListener('click', () => {
    const open = nav.classList.toggle('hidden') === false;
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
