---
/* A small server-rendered line chart: no JavaScript, scales with its box.
   Used for team size and the share of papers by entirely new teams, where a full chart island is more
   than the data needs. */
interface Props {
  points: { x: number; y: number }[];
  format?: 'number' | 'percent';
  label: string;
  color?: string;
  height?: number;
  yMin?: number;
  /* viewBox width: smaller makes the labels larger relative to the line */
  width?: number;
}
const { points, format = 'number', label, color = 'var(--accent)', height = 150, yMin, width = 560 } = Astro.props;
const w = width;
const h = height;
const padL = 40;
const padR = 12;
const padT = 12;
const padB = 22;
const fmt = (v: number) => (format === 'percent' ? `${Math.round(v * 100)}%` : v.toFixed(1));
const ys = points.map((p) => p.y);
const lo = yMin ?? Math.min(...ys) * 0.9;
const hi = Math.max(...ys) * 1.05 || 1;
const x0 = points[0]?.x ?? 0;
const x1 = points[points.length - 1]?.x ?? 1;
const sx = (x: number) => padL + ((x - x0) / Math.max(1, x1 - x0)) * (w - padL - padR);
const sy = (y: number) => padT + (1 - (y - lo) / Math.max(1e-9, hi - lo)) * (h - padT - padB);
const path = points.map((p, i) => `${i ? 'L' : 'M'}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join(' ');
const area = points.length ? `${path} L${sx(x1).toFixed(1)},${h - padB} L${sx(x0).toFixed(1)},${h - padB} Z` : '';
const ticks = [lo, (lo + hi) / 2, hi];
const last = points[points.length - 1];
---
{points.length > 1 ? (
  <svg viewBox={`0 0 ${w} ${h}`} class="h-auto w-full" role="img" aria-label={`${label}: ${fmt(points[0].y)} in ${x0}, ${fmt(last.y)} in ${x1}`}>
    {ticks.map((t) => (
      <g>
        <line x1={padL} x2={w - padR} y1={sy(t)} y2={sy(t)} stroke="var(--border)" stroke-width="1" />
        <text x={padL - 6} y={sy(t) + 4} text-anchor="end" font-size="11" fill="var(--text-muted)">{fmt(t)}</text>
      </g>
    ))}
    <path d={area} fill={color} opacity="0.1" />
    <path d={path} fill="none" stroke={color} stroke-width="2" stroke-linejoin="round" />
    {points.map((p) => (
      <circle cx={sx(p.x)} cy={sy(p.y)} r="6" fill="transparent"><title>{`${p.x}: ${fmt(p.y)}`}</title></circle>
    ))}
    <circle cx={sx(last.x)} cy={sy(last.y)} r="3.5" fill={color} />
    <text x={padL} y={h - 6} font-size="11" fill="var(--text-muted)">{x0}</text>
    <text x={w - padR} y={h - 6} text-anchor="end" font-size="11" fill="var(--text-muted)">{x1}</text>
  </svg>
) : (
  <p class="text-sm text-muted">Not enough years yet.</p>
)}
