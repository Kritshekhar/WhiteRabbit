---
/* The last few changes to one venue or grant, for its page's sidebar. */
import { changeItems } from '@/lib/changes';
import { href } from '@/lib/utils';

interface Props { id: string }
const items = changeItems(Astro.props.id).slice(0, 5);
const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
{items.length > 0 && (
  <section class="card p-4" aria-labelledby={`hist-${Astro.props.id}`}>
    <h3 id={`hist-${Astro.props.id}`} class="mb-2 text-xs font-semibold tracking-wide text-muted uppercase">Recent changes</h3>
    <ol class="space-y-2 text-sm">
      {items.map((c) => (
        <li>
          <p class="text-fg-2">{c.headline}</p>
          <p class="text-xs text-muted">
            {day(c.at)}{c.source && <> · <a class="hover:text-accent" href={c.source} target="_blank" rel="noopener">source ↗</a></>}
          </p>
        </li>
      ))}
    </ol>
    <a class="mt-3 inline-block text-xs font-semibold text-accent hover:underline" href={href('changes/')}>All changes</a>
  </section>
)}
